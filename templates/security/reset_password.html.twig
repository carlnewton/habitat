{% extends 'base.html.twig' %}
{% set page_title = 'account.reset_password.title' | trans %}

{% block body %}
    <form method="post">
        <h1 class="h3 mb-3 font-weight-normal">{{ 'account.reset_password.title' | trans }}</h1>
        {% if validation_failed is defined %}
            <div class="alert alert-danger">{{ 'fields.password.help_text' | trans }}</div>
        {% endif %}
        <div class="form-floating mb-3">
            <input type="password" class="form-control" id="password" name="password" autocomplete="password" required autofocus>
            <label for="password">Password</label>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-lg btn-primary" type="submit">{{ 'buttons.reset_password' | trans }}</button>
    </form>
{% endblock %}
